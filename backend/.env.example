# Django Security
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (MySQL)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Google OAuth Client ID (get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=383403689217-u98mrkajj5gr3508pj7h17d8nsv3kajc.apps.googleusercontent.com

# Razorpay Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Role Access Codes (Required for Admin/Employee Registration)
ADMIN_SECRET_CODE=your_secret_admin_code_here
EMPLOYEE_SECRET_CODE=your_secret_staff_code_here

# Email Configuration
# Render: use Resend's HTTPS API because outbound SMTP may time out.
EMAIL_PROVIDER=smtp
EMAIL_OTP_TEST_MODE=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# For development: Use console backend (prints emails to terminal)
# For production: Use SMTP backend (sends real emails)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Frontend URL (For CORS)
FRONTEND_URL=http://localhost:3000

# Firebase Configuration (for Phone OTP)
# Option 1: Use service account file
FIREBASE_CREDENTIALS_PATH=./path/to/firebase-service-account.json
# Option 2: Use JSON string from environment variable
# FIREBASE_CREDENTIALS_JSON='{"type": "service_account", "project_id": "your-project-id", ...}'
